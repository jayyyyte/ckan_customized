# Template for docker/.env — copy it and fill in, or run ./make-env.sh to generate
# the passwords and secrets. .env is never committed (see .gitignore).
#
# Every key here becomes an environment variable of the ckan and ckan-worker containers.
# Phase 3 uses the same keys: the plain ones in a ConfigMap, the marked ones in a Secret.
# Keep comments on their own line — a value runs to the end of its line.
#
# How the names work (docs/phase-2-docker-packaging.md):
#   CKAN_SITE_URL            a variable CKAN core reads by itself
#   CKAN__A__B   -> ckan.a.b via the envvars plugin (it must stay last in CKAN__PLUGINS)
#   CKAN___A__B  -> a.b      (three underscores: no ckan. prefix)

# --- Passwords (SECRET; compose builds the postgresql:// URLs out of them) ----------
# Stick to URL-safe characters (letters, digits, - and _): the values end up inside a
# connection URL, where @ : / ? # would have to be percent-encoded (gotchas 6e).
# Superuser of the db container. CKAN never uses it.
POSTGRES_PASSWORD=change-me
# Role ckan_default: main database and DataStore writes.
CKAN_DB_PASSWORD=change-me
# Role datastore_default: SELECT-only, used by the DataStore API.
DATASTORE_RO_PASSWORD=change-me

# --- Where the portal answers -------------------------------------------------------
# Host port. It must match the port inside CKAN_SITE_URL.
CKAN_PORT=5000
# CKAN builds absolute URLs and cookies from this; reaching the portal on any other
# address breaks logins and static files (gotchas 10). On K8s: http://10.1.117.91:30500
CKAN_SITE_URL=http://localhost:5000
CKAN_SITE_ID=default
# Image tag to build and run. Never `latest` (gotchas 16).
CKAN_IMAGE=ckan-lakehouse:0.1.0

# --- First sysadmin: prerun.py creates it when the user does not exist yet -----------
CKAN_SYSADMIN_NAME=admin
# SECRET
CKAN_SYSADMIN_PASSWORD=change-me
CKAN_SYSADMIN_EMAIL=admin@example.com

# --- Secrets (SECRET) ----------------------------------------------------------------
# start_ckan.sh generates these into ckan.ini whenever they are empty, and ckan.ini lives
# in the container filesystem: without fixed values every restart logs everyone out and
# invalidates all API tokens, Airflow's included (gotchas 11).
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe())'
CKAN___SECRET_KEY=generate-me
CKAN___WTF_CSRF_SECRET_KEY=generate-me
# Both JWT secrets must hold the same value, prefixed with "string:".
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:generate-me
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:generate-me

# --- CKAN core (same values as the local install) -------------------------------------
# The theme first, envvars last. datastore/xloader/datatables_view are the DataStore
# part (roadmap Q4).
CKAN__PLUGINS=evntheme activity tracking datastore xloader text_view image_view datatables_view envvars
CKAN__LOCALE_DEFAULT=vi
CKAN__LOCALES_OFFERED=vi en
CKAN__SITE_TITLE=Cổng dữ liệu EVN
CKAN__SITE_DESCRIPTION=Chia sẻ dữ liệu dùng chung toàn Tập đoàn
CKAN__FAVICON=/evntheme/images/favicon.svg
CKAN__VIEWS__DEFAULT_VIEWS=image_view datatables_view
CKAN_MAX_UPLOAD_SIZE_MB=10
# CKAN 2.11 only ships the classic templates, so CKAN__BASE_TEMPLATES_FOLDER and
# CKAN__BASE_PUBLIC_FOLDER stay unset (decision log 2026-09-18).

# --- Theme: ckanext.evntheme.* (all options in ckanext-evntheme/README.md) ------------
CKANEXT__EVNTHEME__DOMAIN_GROUPS=kinh-doanh-dvkh ky-thuat-an-toan dau-tu-xay-dung tai-chinh-vat-tu to-chuc-nhan-su
# Technical catalog link in the footer; empty hides it. On the cluster: http://10.1.117.91:30858
CKANEXT__EVNTHEME__OPENMETADATA_URL=
# Leave the map tiles empty where there is no Internet: shapes are still drawn.
CKANEXT__EVNTHEME__MAP_TILE_URL=

# --- XLoader --------------------------------------------------------------------------
# Leave this COMMENTED OUT to let the web container mint a token for CKAN_SYSADMIN_NAME on
# every start (docker-entrypoint.d/20-xloader-token.sh). An empty value is not the same as
# an unset one: envvars would push "" into the config and CKAN refuses to start with
# "ckanext.xloader.api_token: Missing value", because the option is declared not_missing.
# Uncomment and fill it in (SECRET) to pin one token instead.
#CKANEXT__XLOADER__API_TOKEN=
