msgstr "Bạn không thể tự gỡ quyền sysadmin của chính tài khoản đang đăng nhập."

msgid "You cannot deactivate your own account."
msgstr "Bạn không thể tự khóa tài khoản của chính mình."

msgid "Cannot activate: email '{email}' is already used by '{user}'."
msgstr "Không thể mở khóa: email '{email}' đang được sử dụng bởi '{user}'."

msgid "Invalid unit type."
msgstr "Loại đơn vị không hợp lệ."

msgid "Unit '{name}' not found."
msgstr "Không tìm thấy đơn vị '{name}'."

msgid "Invalid role '{role}'."
msgstr "Vai trò '{role}' không hợp lệ."

msgid "Active user '{name}' not found."
msgstr "Không tìm thấy người dùng đang hoạt động '{name}'."

msgid "Created user '{user}' and assigned permissions."
msgstr "Đã tạo người dùng '{user}' và gán phân quyền."

msgid "Updated permissions for '{user}' ({n} changes)."
msgstr "Đã cập nhật phân quyền cho '{user}' ({n} thay đổi)."

msgid "No permission changes for '{user}'."
msgstr "Không có thay đổi phân quyền nào cho '{user}'."

msgid "Reset password for '{user}'."
msgstr "Đã đặt lại mật khẩu cho '{user}'."

msgid "Reactivated user '{user}'."
msgstr "Đã mở khóa tài khoản '{user}'."

msgid "Deactivated user '{user}' and removed their active unit memberships."
msgstr "Đã khóa tài khoản '{user}' và gỡ các quyền thành viên đơn vị hiện tại."

msgid "Updated members of '{unit}' ({n} changes)."
msgstr "Đã cập nhật thành viên của '{unit}' ({n} thay đổi)."

msgid "No member changes for '{unit}'."
msgstr "Không có thay đổi thành viên nào cho '{unit}'."


