msgstr "Các cột"

msgid "Type"
msgstr "Kiểu"

msgid "Description"
msgstr "Mô tả"

msgid "OpenMetadata lists no columns for this table."
msgstr "OpenMetadata không có danh sách cột của bảng này."

msgid "Could not load the technical catalog. Reload the page to try again."
msgstr "Không tải được danh mục kỹ thuật. Hãy tải lại trang để thử lại."

msgid "Loading the technical catalog…"
msgstr "Đang tải danh mục kỹ thuật…"

msgid "Show the technical catalog"
msgstr "Xem danh mục kỹ thuật"

