# Vietnamese translations for ckanext-lakehouse_theme.
# Covers the theme's own strings plus core strings that the CKAN 2.11.6 vi catalog
# leaves untranslated on the main pages (plugin catalogs are merged after core).
# Compile: pybabel compile -d ckanext/lakehouse_theme/i18n -D ckanext-lakehouse_theme
msgid ""
msgstr ""
"Project-Id-Version: ckanext-lakehouse_theme 0.0.1\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# --- Theme strings

msgid "Trusted data, ready to use"
msgstr "Dữ liệu tin cậy, sẵn sàng sử dụng"

msgid "Find curated datasets from the Lakehouse, check their metadata, then query them directly with Trino or download a copy."
msgstr "Tìm bộ dữ liệu đã chuẩn hóa từ Lakehouse, xem metadata, rồi truy vấn trực tiếp bằng Trino hoặc tải bản sao về."

msgid "dataset"
msgid_plural "datasets"
msgstr[0] "bộ dữ liệu"

msgid "organization"
msgid_plural "organizations"
msgstr[0] "tổ chức"

msgid "Recent Datasets"
msgstr "Bộ dữ liệu mới cập nhật"

msgid "View all datasets"
msgstr "Xem tất cả bộ dữ liệu"

msgid "No datasets have been published yet."
msgstr "Chưa có bộ dữ liệu nào được công bố."

msgid "Curated datasets published from the Lakehouse platform, ready to query with Trino or download."
msgstr "Các bộ dữ liệu đã chuẩn hóa được công bố từ nền tảng Lakehouse, có thể truy vấn bằng Trino hoặc tải về."

# Core vi has "Tìm hiểu"; the footer heading reads better as "Khám phá".
msgid "Explore"
msgstr "Khám phá"

msgid "For developers"
msgstr "Dành cho nhà phát triển"

msgid "Technical catalog (OpenMetadata)"
msgstr "Catalog kỹ thuật (OpenMetadata)"

msgid "Connecting with Trino JDBC"
msgstr "Kết nối bằng Trino JDBC"

msgid "How to connect"
msgstr "Cách kết nối"

msgid "This resource is a table in the Lakehouse. Query it directly with Trino instead of downloading a copy."
msgstr "Tài nguyên này là một bảng trong Lakehouse. Hãy truy vấn trực tiếp bằng Trino thay vì tải bản sao về."

msgid "Copy"
msgstr "Sao chép"

msgid "Copied"
msgstr "Đã sao chép"

msgid "In DBeaver or DataGrip, create a Trino connection and paste the JDBC URL. Sign in with your Lakehouse account."
msgstr "Trong DBeaver hoặc DataGrip, tạo kết nối Trino rồi dán JDBC URL. Đăng nhập bằng tài khoản Lakehouse của bạn."

# --- Core strings missing from the CKAN 2.11.6 vi catalog (header, home, dataset, resource pages)

msgid "Search data"
msgstr "Tìm kiếm dữ liệu"

msgid "E.g. environment"
msgstr "Ví dụ: môi trường"

msgid "Search datasets"
msgstr "Tìm bộ dữ liệu"

msgid "Search Datasets..."
msgstr "Tìm bộ dữ liệu..."

msgid "Submit"
msgstr "Gửi"

msgid "Toggle navigation"
msgstr "Mở/đóng menu"

msgid "Account"
msgstr "Tài khoản"

msgid "Profile settings"
msgstr "Cài đặt tài khoản"

msgid "View dashboard"
msgstr "Xem bảng điều khiển"

msgid "Skip to main content"
msgstr "Chuyển tới nội dung chính"

msgid "Breadcrumb"
msgstr "Đường dẫn trang"

msgid "Last Updated"
msgstr "Cập nhật lần cuối"

msgid "Data last updated"
msgstr "Dữ liệu cập nhật lần cuối"

msgid "Metadata last updated"
msgstr "Metadata cập nhật lần cuối"

msgid "Dataset description:"
msgstr "Mô tả bộ dữ liệu:"

msgid "There is no description for this dataset"
msgstr "Bộ dữ liệu này chưa có mô tả"

msgid "This dataset has no data"
msgstr "Bộ dữ liệu này chưa có dữ liệu"

msgid "Here are some reasons you may not be seeing expected views:"
msgstr "Một số lý do khiến bạn không thấy chế độ xem như mong đợi:"

msgid "No view has been created that is suitable for this resource"
msgstr "Chưa có chế độ xem nào phù hợp với tài nguyên này"

msgid "The site administrators may not have enabled the relevant view plugins"
msgstr "Quản trị viên có thể chưa bật plugin hiển thị tương ứng"

msgid "If a view requires the DataStore, the DataStore plugin may not be enabled, or the data may not have been pushed to the DataStore, or the DataStore hasn't finished processing the data yet"
msgstr "Nếu chế độ xem cần DataStore thì có thể plugin DataStore chưa được bật, dữ liệu chưa được đẩy vào DataStore, hoặc DataStore chưa xử lý xong"

# --- Core strings the vi catalog translates awkwardly

# Core vi: "{number} số bộ dữ liệu tìm thấy".
msgid "{number} dataset found"
msgid_plural "{number} datasets found"
msgstr[0] "Tìm thấy {number} bộ dữ liệu"

msgid "{number} dataset found for \"{query}\""
msgid_plural "{number} datasets found for \"{query}\""
msgstr[0] "Tìm thấy {number} bộ dữ liệu cho \"{query}\""

msgid "{number} organization found"
msgid_plural "{number} organizations found"
msgstr[0] "Tìm thấy {number} tổ chức"

msgid "{number} group found"
msgid_plural "{number} groups found"
msgstr[0] "Tìm thấy {number} nhóm"

# Untranslated in core vi (organization/group cards).
msgid "{num} Member"
msgid_plural "{num} Members"
msgstr[0] "{num} thành viên"

msgid "0 Members"
msgstr "0 thành viên"

# Core vi translates this as "Giao diện người sử dụng CKAN" (user interface), which is wrong.
msgid "CKAN API"
msgstr "CKAN API"
