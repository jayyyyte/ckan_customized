# This cluster: k8s-master 10.1.117.91, k8s-worker1 10.1.117.88, k8s-worker2 10.1.117.235.
# Absolute URLs and cookies are built from this: the portal must be opened on exactly
# this address (gotchas 10). Canonical access is now the nginx reverse proxy at
# ckan-stg.evn.com.vn; NodePort 30500 on the master's IP keeps working for direct
# access, but any generated absolute link (emails, sitemap, "copy link") shows this domain.
CKAN_SITE_URL=https://ckan-stg.evn.com.vn

# OpenMetadata sync (ckan-openmetadata-sync CronJob, every 30 min): one CKAN dataset per
# table catalogued in OpenMetadata, resource = Trino JDBC connection + DataStore preview.
# In-cluster Service, not the ingress host: ckan-stg.evn.com.vn/openmetadata-stag.evn.com.vn
# have no DNS record yet, and this is a pod-to-pod call anyway (kubectl -n openmetadata get svc).
CKANEXT__EVNTHEME__OPENMETADATA_API_URL=http://openmetadata.openmetadata.svc.cluster.local:8585/api
CKANEXT__EVNTHEME__OPENMETADATA_URL=https://openmetadata-stag.evn.com.vn
# Shown to users in the JDBC resource; docs/cluster-context.md said 30800, the real NodePort
# is 30084 (kubectl -n trino get svc).
CKANEXT__EVNTHEME__OPENMETADATA_TRINO_HOST=10.1.117.91:30084
# What CKAN itself connects to for the data preview: the in-cluster Service, not the NodePort
# (avoids depending on node networking/firewall for a pod-to-pod call).
CKANEXT__EVNTHEME__TRINO_QUERY_HOST=trino.trino.svc.cluster.local:8080
# Only sync tables tagged like this in OpenMetadata; empty means every table.
CKANEXT__EVNTHEME__OPENMETADATA_PUBLISH_TAG=
# Existing CKAN organisation that owns synced datasets when no team mapping claims them.
CKANEXT__EVNTHEME__OPENMETADATA_OWNER_ORG=vttb
# Live data preview: query up to N rows from Trino into the resource's DataStore (column
# descriptions come from OpenMetadata regardless). Empty CKANEXT__EVNTHEME__TRINO_PASSWORD
# (in secrets.env, not here) skips BasicAuthentication when Trino has no password auth.
CKANEXT__EVNTHEME__TRINO_USER=trino
CKANEXT__EVNTHEME__OPENMETADATA_PREVIEW_ROWS=1000
# NOTE: Put CKANEXT__EVNTHEME__OPENMETADATA_TOKEN (and/or CKANEXT__LAKEHOUSE__OM__API_TOKEN)
# in k8s/overlays/onprem/secrets.env (never in config.env).

# Technical catalog tab ("Danh mục kỹ thuật") & ckanext-lakehouse OpenMetadata tools:
CKANEXT__LAKEHOUSE__OM__URL=http://openmetadata.openmetadata.svc.cluster.local:8585
CKANEXT__LAKEHOUSE__OM__UI_URL=https://openmetadata-stag.evn.com.vn
CKANEXT__LAKEHOUSE__OM__DEFAULT_ORG=vttb
CKANEXT__LAKEHOUSE__OM__TRINO_JDBC_URL=jdbc:trino://10.1.117.91:30084

CKAN__AUTH__CREATE_USER_VIA_WEB=true
CKAN__AUTH__USER_CREATE_ORGANIZATIONS=true
CKAN__AUTH__USER_CREATE_GROUPS=true
CKAN__AUTH__PUBLIC_USER_DETAILS=true
