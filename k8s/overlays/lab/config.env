# Company cluster: only what differs from k8s/base/config.env.

# Absolute URLs and cookies are built from this: the portal must be opened on exactly
# this address (gotchas 10). NodePort 30500 on the master's IP.
CKAN_SITE_URL=http://10.1.117.91:30500

# Footer link "Danh mục kỹ thuật" (OpenMetadata on the same cluster).
CKANEXT__EVNTHEME__OPENMETADATA_URL=http://10.1.117.91:30858

# OpenMetadata on the same cluster. NodePort for now; switch to its in-cluster Service once
# the audit has the name (docs/phase-4-content-openmetadata.md §4.6).
CKANEXT__LAKEHOUSE__OM__URL=http://10.1.117.91:30858
CKANEXT__LAKEHOUSE__OM__UI_URL=http://10.1.117.91:30858
CKANEXT__LAKEHOUSE__OM__TRINO_JDBC_URL=jdbc:trino://10.1.117.91:30800
# Empty on purpose until the scope is agreed (§4.6): the sync publishes nothing yet.
CKANEXT__LAKEHOUSE__OM__INCLUDE=
