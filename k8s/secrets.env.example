# Keys of the ckan-secrets Secret. Never fill this file in: generate the real one with
#   bash k8s/scripts/make-secrets.sh <overlay>     -> k8s/overlays/<overlay>/secrets.env
# which stays out of git (.gitignore) and is turned into the Secret by `kubectl apply -k`.
#
# Unlike compose, the URLs are written out in full: a Secret cannot assemble them. The
# password of ckan_default therefore appears in three of them — keep them identical.
# Stick to URL-safe characters (make-secrets.sh does): @ : / ? # would need
# percent-encoding (gotchas 6e).
# k8s/scripts/prepare-postgres.sh reads the role names, passwords and database names
# back from these URLs to create them on postgres-service.

# --- Postgres (postgres-service, shared: CKAN only adds these two roles and databases) ---
CKAN_SQLALCHEMY_URL=postgresql://ckan_default:change-me@postgres-service:5432/ckan_default
CKAN_DATASTORE_WRITE_URL=postgresql://ckan_default:change-me@postgres-service:5432/datastore_default
CKAN_DATASTORE_READ_URL=postgresql://datastore_default:change-me@postgres-service:5432/datastore_default
# XLoader's job log, in the CKAN database rather than an SQLite file per pod.
CKANEXT__XLOADER__JOBS_DB__URI=postgresql://ckan_default:change-me@postgres-service:5432/ckan_default

# --- First sysadmin (CKAN_SYSADMIN_NAME / _EMAIL are in the ConfigMap) ------------------
CKAN_SYSADMIN_PASSWORD=change-me

# --- Session, CSRF and API token secrets ------------------------------------------------
# Fixed values, or every restart logs everyone out and voids every API token, Airflow's
# included (gotchas 11). Both JWT secrets hold the same value, prefixed with "string:".
CKAN___SECRET_KEY=generate-me
CKAN___WTF_CSRF_SECRET_KEY=generate-me
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:generate-me
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:generate-me

# --- XLoader API token --------------------------------------------------------------------
# Leave it out to let the web pod mint one for CKAN_SYSADMIN_NAME on every start. An empty
# value is not the same as a missing one: CKAN would refuse to start (gotchas 15a).
#CKANEXT__XLOADER__API_TOKEN=
