# Non-secret settings of ckan, ckan-worker and ckan-tracking-update (ConfigMap ckan-config).
# Same keys and values as docker/.env.example; secrets live in the overlay's secrets.env.
# An overlay overrides a key by listing it again in its own config.env.
#
# A key set to an empty value is NOT the same as a key left out (gotchas 15a).

# --- Services inside the namespace (short names resolve within lakehouse) ------------
CKAN_SITE_ID=default
CKAN_SOLR_URL=http://ckan-solr:8983/solr/ckan
CKAN_REDIS_URL=redis://ckan-redis:6379/0
# XLoader jobs run in ckan-worker, which cannot reach ckan.site_url when that is a
# browser address: it rewrites download and callback URLs to this one (gotchas 15c).
CKANEXT__XLOADER__SITE_URL=http://ckan-service:5000

# --- CKAN core -------------------------------------------------------------------------
# The theme first, envvars last. Baked into the image's ckan.ini too; the worker and the
# CronJob write this value back into the ini before starting (gotchas 15b).
CKAN__PLUGINS=evntheme activity tracking datastore xloader text_view image_view datatables_view envvars
CKAN__LOCALE_DEFAULT=vi
CKAN__LOCALES_OFFERED=vi en
CKAN__SITE_TITLE=Cổng dữ liệu EVN
CKAN__SITE_DESCRIPTION=Chia sẻ dữ liệu dùng chung toàn Tập đoàn
CKAN__FAVICON=/evntheme/images/favicon.svg
CKAN__VIEWS__DEFAULT_VIEWS=image_view datatables_view
CKAN_MAX_UPLOAD_SIZE_MB=10

# --- uWSGI (start_ckan.sh appends this to its options) --------------------------------------
# uWSGI sizes its tables by the open-files limit it inherits. Docker hands containers
# 1048576; containerd on a kubeadm/kind node can hand them 1073741816, and the pod was
# OOMKilled at 2Gi a second after "WSGI app ready" (gotchas 21a). Pin it.
EXTRA_UWSGI_OPTS=--max-fd 65536

# --- First sysadmin: prerun.py creates it if missing; its password is in the Secret -----
# The web container also mints the XLoader API token for this user on every start.
CKAN_SYSADMIN_NAME=admin
CKAN_SYSADMIN_EMAIL=admin@example.com

# --- Theme (ckanext-evntheme/README.md) -------------------------------------------------
CKANEXT__EVNTHEME__DOMAIN_GROUPS=kinh-doanh-dvkh ky-thuat-an-toan dau-tu-xay-dung tai-chinh-vat-tu to-chuc-nhan-su
# Empty hides the footer link; overlays/lab sets the cluster's OpenMetadata.
CKANEXT__EVNTHEME__OPENMETADATA_URL=
# Empty: no map tiles (the cluster may have no Internet); shapes are still drawn.
CKANEXT__EVNTHEME__MAP_TILE_URL=
