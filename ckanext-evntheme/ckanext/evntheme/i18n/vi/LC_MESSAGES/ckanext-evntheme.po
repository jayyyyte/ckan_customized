msgid "Data last updated"
msgstr "Dữ liệu cập nhật lần cuối"

msgid "Metadata last updated"
msgstr "Metadata cập nhật lần cuối"

msgid "There is no description for this dataset"
msgstr "Bộ dữ liệu này chưa có mô tả"

msgid "This dataset has no data"
msgstr "Bộ dữ liệu này chưa có dữ liệu"

msgid "Here are some reasons you may not be seeing expected views:"
msgstr "Một số lý do khiến bạn không thấy chế độ xem như mong đợi:"

msgid "No view has been created that is suitable for this resource"
msgstr "Chưa có chế độ xem nào phù hợp với tài nguyên này"

msgid "The site administrators may not have enabled the relevant view plugins"
msgstr "Quản trị viên có thể chưa bật plugin hiển thị tương ứng"

msgid "If a view requires the DataStore, the DataStore plugin may not be enabled, or the data may not have been pushed to the DataStore, or the DataStore hasn't finished processing the data yet"
msgstr "Nếu chế độ xem cần DataStore thì có thể plugin DataStore chưa được bật, dữ liệu chưa được đẩy vào DataStore, hoặc DataStore chưa xử lý xong"

